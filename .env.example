# MITRERedTeam 环境变量示例
# 复制本文件为 .env 并填写实际值。.env 已被 .gitignore 忽略，不会进入版本仓库。

# 通知平台：telegram / wechat / none（默认 none，表示不发送通知）
NOTIFICATION_PLATFORM=none

# Telegram 通知（platform=telegram 时必填）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WeChat 通知（platform=wechat 时必填）
# 通过本机 OpenClaw gateway 发送：微信账号先用
#   openclaw channels login --channel openclaw-weixin
# 扫码绑定，消息经 gateway 长连接投递，无需外部 API 凭据。
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_WECHAT_CHANNEL=openclaw-weixin
# 接收方标识（由 OpenClaw 侧定义，如会话 key）
OPENCLAW_WECHAT_TO=

# --- AI 辅助（--ai 模式）---
# 至少配置一家供应商的 API Key，--ai 时程序会从已配置的供应商中随机选择。
# 未配置任何供应商时 --ai 会明确报错，不会静默失败。

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（官方模型 id：deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Kimi（Moonshot）
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3

# 豆包（火山方舟，model 填控制台的推理接入点 ID 或模型 ID）
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260628

# OpenRouter（模型填任意模型 slug，如 openai/gpt-latest）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic（模型填 Claude 系列，如 claude-sonnet-4-5）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
