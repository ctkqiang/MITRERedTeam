#!/bin/sh

set -u

# 暂存区中待提交的 .go 文件（排除已删除的 D）
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if [ -n "$STAGED_GO_FILES" ]; then
    UNFORMATTED=$(gofmt -l $STAGED_GO_FILES)
    if [ -n "$UNFORMATTED" ]; then
        echo "==> gofmt 检查未通过:"
        echo "$UNFORMATTED"
        echo "==> 请先运行 go fmt ./...，再 git add 后重新提交"
        exit 1
    fi
    echo "==> gofmt 检查通过"
fi

# test/ 目录仅存放 *_test.go 测试文件，不产生构建产物，需从 build 目标中排除
BUILD_TARGETS=$(go list ./... | grep -v '/test$')
echo "==> go build ./..."
go build $BUILD_TARGETS &
if ! wait $!; then
    echo "==> go build 失败，提交已中止"
    exit 1
fi

echo "==> go test -v ./..."
if ! go test -v ./...; then
    echo "==> go test 失败，提交已中止"
    exit 1
fi

# 4. 静态分析（未安装 golangci-lint 时直接跳过）
if command -v golangci-lint >/dev/null 2>&1; then
    echo "==> golangci-lint run"
    if ! golangci-lint run; then
        echo "==> golangci-lint 检查未通过，提交已中止"
        exit 1
    fi
fi

echo "==> 全部检查通过"
exit 0
